# M1: warnings and errors (spec chapter 12)
msgid "diag.E-02"
msgstr "[KxNFTM-E-02] Wrong location"

msgid "diag.E-02:description"
msgstr "Place Kx VRC NativeFT Manager inside an avatar that has a VRCAvatarDescriptor."

msgid "diag.E-03"
msgstr "[KxNFTM-E-03] No Blendshapes Set"

msgid "diag.E-03:description"
msgstr "The Avatar Descriptor has no Blendshapes Set, so face tracking does nothing. With Kx VRC ARKit BlendShape Generator, set Generator Integration to Auto; otherwise create a Set with the Descriptor's auto fill or by hand."

msgid "diag.E-04"
msgstr "[KxNFTM-E-04] Jerry's Face Tracking Templates is still on the avatar"

msgid "diag.E-04:description"
msgstr "It cannot be used together with native face tracking on the same avatar (found: {0}). On an avatar with Use All Tracking Keys, Jerry's does not run and only its synced bits remain, and MA_EyeRotation may stop the native eye gaze through a saved EyeTrackingActive. Remove Jerry's from the avatar."

msgid "diag.E-05"
msgstr "[KxNFTM-E-05] Toggle State Behavior not found"

msgid "diag.E-05:description"
msgstr "The face tracking Blendshapes State Behavior was not found in the VRChat SDK, so the toggles cannot switch the Set weights. The Sets were split and the Descriptor settings were applied. Check the SDK version (details: {0})."

msgid "diag.E-06"
msgstr "[KxNFTM-E-06] Tracking keys do not match the SDK"

msgid "diag.E-06:description"
msgstr "The FaceTrackingKey of the VRChat SDK differs from this tool's table, so the Sets were not split ({0}). Update this tool."

msgid "diag.W-01"
msgstr "[KxNFTM-W-01] ARKit BlendShape Generator not found"

msgid "diag.W-01:description"
msgstr "The preset is ARKit, but the avatar has no Kx VRC ARKit BlendShape Generator. Add the Generator or change the preset to UE."

msgid "diag.W-02"
msgstr "[KxNFTM-W-02] Generator shapes are not used for face tracking"

msgid "diag.W-02:description"
msgstr "Generator Integration is Off and the Generator's Blendshapes Set output is off as well, so the generated shapes are not added to any Set. Set Generator Integration to Auto."

msgid "diag.W-03"
msgstr "[KxNFTM-W-03] Generator version does not support the integration"

msgid "diag.W-03:description"
msgstr "The Kx VRC ARKit BlendShape Generator on the avatar is not a version that supports the integration. Update the Generator. Until then, enabling its Blendshapes Set output by hand still lets the split and toggles work."

msgid "diag.W-04"
msgstr "[KxNFTM-W-04] Generator Set has too few keys"

msgid "diag.W-04:description"
msgstr "Only {0} keys are assigned in the Generator's Blendshapes Set. The source shapes may not have been found. Check the Generator settings."

msgid "diag.W-05"
msgstr "[KxNFTM-W-05] Use All Tracking Keys is off"

msgid "diag.W-05:description"
msgstr "Only the 10 basic eye keys are tracked. Turn on Enable Use All Tracking Keys, or enable it on the Avatar Descriptor."

msgid "diag.W-07"
msgstr "[KxNFTM-W-07] Eye Look rotation range is too narrow"

msgid "diag.W-07:description"
msgstr "One direction of the Eye Look rotation on the Avatar Descriptor is only {0}°, so the eyes barely move. Widen it to about ±10-15° vertically and ±15-20° horizontally."

msgid "diag.W-08"
msgstr "[KxNFTM-W-08] Do not use with Kx VRC FE-JsT Bridge"

msgid "diag.W-08:description"
msgstr "The avatar has Kx VRC FE-JsT Bridge. Suppressing FaceEmo is a feature planned for this tool, and FE-JsT Bridge does not trigger on an avatar with native face tracking. Remove FE-JsT Bridge."

msgid "diag.W-09"
msgstr "[KxNFTM-W-09] Parameter name conflict"

msgid "diag.W-09:description"
msgstr "Another MA Parameters also defines this tool's parameters ({0}). Rename one of them."

msgid "diag.W-10"
msgstr "[KxNFTM-W-10] A Set was not split"

msgid "diag.W-10:description"
msgstr "The Blendshapes Set \"{0}\" is referenced by name from an existing Parameter Behavior, so it was not split. This Set is not switched by the toggles."

msgid "diag.W-14"
msgstr "[KxNFTM-W-14] Avatar Optimizer does not support native face tracking"

msgid "diag.W-14:description"
msgstr "This version of Avatar Optimizer does not support native face tracking. Optimization may remove or rename shapes used by Blendshapes Sets and Parameter Behaviors, breaking face tracking. Update Avatar Optimizer to 1.9.21-beta.1 or later."

msgid "diag.W-15"
msgstr "[KxNFTM-W-15] Avatar Optimizer's native face tracking support is disabled by the SDK version"

msgid "diag.W-15:description"
msgstr "Avatar Optimizer's native face tracking support is enabled only with VRChat SDK 3.10.6-beta.3 or later. With the current SDK, optimization may break face tracking shapes. Update the SDK to 3.10.6-beta.3 or later."
