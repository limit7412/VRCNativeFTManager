msgstr "Add the toggles to the table"

msgid "inspector.section.corrections"
msgstr "Expression Corrections"

msgid "inspector.enable_emulation"
msgstr "Emulation"

msgid "inspector.enable_emulation.tooltip"
msgstr "Adds Parameter Behaviors such as raising the cheeks and dimples when smiling, or moving the brows with the mouth (ported from Jerry's 7.0.5). When off, no gate Set or toggle is created"

msgid "inspector.enable_limits"
msgstr "Limits"

msgid "inspector.enable_limits.tooltip"
msgstr "Adds Parameter Behaviors that cap shapes, such as the upper lip while funneling (ported from Jerry's 7.0.5). When off, no gate Set or toggle is created"

msgid "inspector.enable_eye_sync"
msgstr "Eye Sync"

msgid "inspector.enable_eye_sync.tooltip"
msgstr "Creates a toggle that closes both eyelids together using their average. When off, no gate Set or toggle is created"

msgid "inspector.corrections.rules"
msgstr "Rules (uncheck to skip)"

msgid "inspector.corrections.no_shape"
msgstr "No target shape"

