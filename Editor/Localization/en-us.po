msgid "inspector.estimate.sets"
msgstr "Sets after splitting"

msgid "inspector.estimate.sets_value"
msgstr "{0} (plus {1} gate Sets)"

msgid "inspector.estimate.behaviors"
msgstr "Parameter Behaviors"

msgid "inspector.estimate.behaviors_value"
msgstr "{0} by this tool ({1} existing)"

msgid "inspector.estimate.instructions"
msgstr "Custom expression instructions"

msgid "inspector.estimate.instructions_value"
msgstr "{0} / {1} ({2} by this tool)"

msgid "inspector.estimate.operations"
msgstr "Face Tracking Operations"

msgid "inspector.estimate.synced_bits"
msgstr "Synced bits"

msgid "inspector.estimate.synced_bits_value"
msgstr "{0} / {1} ({2} by this tool)"

msgid "inspector.estimate.fx_layers"
msgstr "FX layers"

msgid "inspector.estimate.generator_note"
msgstr "The Set of Kx VRC ARKit BlendShape Generator exists only during the build and is not included in the estimate."

# M2: warnings and errors
msgid "diag.W-12"
msgstr "[KxNFTM-W-12] Too many custom expression instructions"

msgid "diag.W-12:description"
msgstr "Custom expressions can use up to 512 instructions per avatar ({1} are used by existing Parameter Behaviors). These lower-priority correction rules were not generated: {0}."

msgid "diag.W-13"
msgstr "[KxNFTM-W-13] Synced bits are likely to exceed the limit"

msgid "diag.W-13:description"
msgstr "Synced parameters are estimated at {0} bits, over the limit of {1} bits ({2} bits by this tool). Remove other parameters or show fewer toggles in the menu (the Minimal preset uses 3 bits)."

msgid "diag.I-01"
msgstr "[KxNFTM-I-01] Some corrections were skipped because the shapes are missing"

msgid "diag.I-01:description"
msgstr "These rules were not generated because no shape is assigned to their tracking keys in the split Sets: {0}. Sets that are not split are left out because their weights are controlled by the user."

# M3: FaceEmo suppression
msgid "inspector.section.face_emo"
msgstr "FaceEmo Suppression"

msgid "inspector.face_emo.enabled"
msgstr "Suppress FaceEmo"

msgid "inspector.face_emo.enabled.tooltip"
msgstr "Keeps FaceEmo's expressions and blinking from writing face shapes while face tracking is active."

msgid "inspector.face_emo.description"
msgstr "The suppression follows the menu toggles. It does not check whether a tracker is sending data, so turn off the Face Tracking toggle when you are not using a tracker."

msgid "prop.face_emo_trigger"
msgstr "Trigger"

msgid "prop.face_emo_trigger.tooltip"
msgstr "Chooses which toggles have to be on for FaceEmo to be stopped."

msgid "prop.face_emo_trigger.eye_or_lip"
msgstr "Eye or lip tracking is on"

msgid "prop.face_emo_trigger.eye_or_lip.tooltip"
msgstr "Stops FaceEmo while Face Tracking is on and either Eye Tracking or Lip Tracking is on."

msgid "prop.face_emo_trigger.lip_only"
msgstr "Lip tracking is on"

msgid "prop.face_emo_trigger.lip_only.tooltip"
msgstr "Stops FaceEmo only while Face Tracking and Lip Tracking are on. With eye tracking alone, FaceEmo's expressions and blinking stay."

msgid "inspector.face_emo.lip_only"
msgstr "FaceEmo is not stopped for eye tracking alone, so FaceEmo's blinking and eye expressions overlap the tracked eyes."

msgid "diag.W-16"
msgstr "[KxNFTM-W-16] FaceEmo suppression never takes effect"

msgid "diag.W-16:description"
msgstr "The toggles the trigger uses (Face Tracking, Eye Tracking, Lip Tracking) are hidden from the menu and off by default, so the trigger can never be met. The suppression layers and the extra parameters are not generated. Show the toggles in the menu or turn their defaults on."

msgid "diag.W-17"
msgstr "[KxNFTM-W-17] FaceEmo parameter names could not be resolved"

msgid "diag.W-17:description"
msgstr "The names of the parameters that the suppression writes could not be read from FaceEmo's MA Parameters. FaceEmo's original names are used. This does not work if FaceEmo adds a prefix to its parameters, so apply FaceEmo again."

msgid "diag.I-03"
msgstr "[KxNFTM-I-03] FaceEmo is on the avatar, but FaceEmo suppression is off"

msgid "diag.I-03:description"
msgstr "FaceEmo's expressions and blinking keep writing face shapes during face tracking and overlap the tracking. Turn on FaceEmo Suppression to stop them."

msgid "diag.I-04"
msgstr "[KxNFTM-I-04] FaceEmo was not found"

msgid "diag.I-04:description"
msgstr "FaceEmo suppression is on, but no FaceEmo was found among the avatar's Merge Animators. If you add FaceEmo later, or FaceEmo is generated during the build, you can leave it as it is. If you do not use FaceEmo, turn the suppression off."

msgid "diag.I-05"
msgstr "[KxNFTM-I-05] Toggles with no Set to switch were removed from the menu"

msgid "diag.I-05:description"
msgstr "No Blendshapes Set is switched by the toggle \"{0}\", so its Expressions Menu item and synced parameter were removed. This happens to Pupil with ARKit shapes, which have no pupil shapes. Assign the keys in a Set to keep the toggle. The Menu Item of a correction toggle left in the hierarchy is also removed when that correction is not generated."

msgid "inspector.face_emo.expression_control"
msgstr "FaceEmo keeps writing, so the avatar's own expression layers stay covered as usual and the menu can still switch expressions while tracking.\nFaceEmo's default face writes the same blend shapes as face tracking, so register the tracking blend shapes in FaceEmo's Excluded Blend Shapes first."

msgid "prop.face_emote_index"
msgstr "Emote Number"

msgid "prop.face_emote_index.tooltip"
msgstr "Number of the emote to switch to while face tracking is active. It is the same number the FaceEmo expression select menu writes, counted from the top of the expression pattern as 0, 1, 2 and so on."

msgid "prop.remove_fx_layers"
msgstr "FX Layers To Remove"

msgid "prop.remove_fx_layers.tooltip"
msgstr "Names of the FX layers removed at build time. The avatar's own assets are not modified."

msgid "inspector.remove_fx_layers"
msgstr "List the avatar's own layers that conflict with face tracking here (blink, Tracking Control switching, and so on) and they are removed from FX at build time.\nOpen the built FX in the Animator window to find the layer names."

msgid "warning.fx_not_found"
msgstr "The FX controller was not found"

msgid "warning.fx_not_found:description"
msgstr "FX layers to remove are listed, but the avatar has no FX controller."

msgid "warning.layer_not_found"
msgstr "An FX layer was not found"

msgid "warning.layer_not_found:description"
msgstr "FX has no layer named {0}, so nothing was removed for it. Check the name."

msgid "warning.layer_not_found:hint"
msgstr "Layers merged later by Merge Animator are out of scope. Only layers in the avatar's own FX can be removed."

msgid "warning.synced_layer_detached"
msgstr "A synced layer lost its source"

msgid "warning.synced_layer_detached:description"
msgstr "The layer {0} referenced was removed, so the reference was cleared."

msgid "info.layers_removed"
msgstr "FX layers were removed"

msgid "info.layers_removed:description"
msgstr "{0}"

msgid "warning.fx_not_editable"
msgstr "The FX controller cannot be edited"

msgid "warning.fx_not_editable:description"
msgstr "FX is still a project asset, so the layer removal was skipped. This keeps the avatar's own asset intact."

msgid "warning.fx_not_editable:hint"
msgstr "Modular Avatar clones the controllers during the build, so this warning does not normally appear."

msgid "warning.layer_control_detached"
msgstr "A layer control lost its target"

msgid "warning.layer_control_detached:description"
msgstr "A VRC Animator Layer Control in {0} pointed at a removed FX layer. Its target was cleared so that it does not drive a different layer."

msgid "warning.layer_control_not_editable"
msgstr "Layer control indices cannot be remapped"

msgid "warning.layer_control_not_editable:description"
msgstr "{0} is still a project asset, so its VRC Animator Layer Control indices could not be remapped. Controls pointing after a removed layer now drive a different layer."

msgid "prop.extra_parameters"
msgstr "Extra Parameters"

msgid "prop.extra_parameters.tooltip"
msgstr "Parameters to set only while face tracking is active, such as toggles made with Modular Avatar."

msgid "inspector.extra_parameters"
msgstr "Each value is written when face tracking is turned on, and handled as set in On Release when it is turned off.\nSynced parameters are written only once at each switch, so you can still change them from the menu while face tracking is active.\nParameters that are not synced are written on every client, and rewritten about every second while face tracking is active."

msgid "inspector.extra_parameters.multi_edit"
msgstr "Extra parameters cannot be edited while multiple components are selected. Select only one."

msgid "prop.extra_parameter.source"
msgstr "Source"

msgid "prop.extra_parameter.source.menu_item"
msgstr "MA Menu Item"

msgid "prop.extra_parameter.source.parameter_name"
msgstr "Parameter Name"

msgid "prop.extra_parameter.menu_item"
msgstr "Menu Item"

msgid "prop.extra_parameter.menu_item.tooltip"
msgstr "An MA Menu Item of the toggle or button type. Its parameter name and toggle value are read at build time."

msgid "prop.extra_parameter.menu_item_state"
msgstr "State While Tracking"

msgid "prop.extra_parameter.state.on"
msgstr "On"

msgid "prop.extra_parameter.state.off"
msgstr "Off"

msgid "prop.extra_parameter.parameter_name"
msgstr "Parameter Name"

msgid "prop.extra_parameter.parameter_name.tooltip"
msgstr "The name used in the FX layer, after Modular Avatar renames it."

msgid "prop.extra_parameter.parameter_type"
msgstr "Type"

msgid "prop.extra_parameter.engaged_value"
msgstr "Value While Tracking"

msgid "prop.extra_parameter.release_mode"
msgstr "On Release"

msgid "prop.extra_parameter.release_mode.revert"
msgstr "Write Release Value"

msgid "prop.extra_parameter.release_mode.keep"
msgstr "Do Nothing"

msgid "prop.extra_parameter.released_value"
msgstr "Release Value"

msgid "prop.extra_parameter.release_mode.restore"
msgstr "Restore Previous Value"

msgid "prop.extra_parameter.sync_mode"
msgstr "Sync"

msgid "prop.extra_parameter.sync_mode.tooltip"
msgstr "Synced parameters are written only on the wearer's client. Parameters that are not synced are written on every client."

msgid "prop.extra_parameter.sync_mode.auto"
msgstr "Auto"

msgid "prop.extra_parameter.sync_mode.synced"
msgstr "Synced"

msgid "prop.extra_parameter.sync_mode.unsynced"
msgstr "Not Synced"

msgid "inspector.extra_parameter.menu_item_revert"
msgstr "With Write Release Value, the menu item is switched to the opposite of its state while tracking."

msgid "inspector.extra_parameter.auto_name"
msgstr "The parameter name is empty, so Kx VRC NativeFT Manager writes to the name Modular Avatar assigns during the build."

msgid "inspector.extra_parameter.no_parameter"
msgstr "The parameter name is empty and Modular Avatar will not assign one, so there is no parameter to write to."

msgid "warning.extra_parameter.empty_name"
msgstr "An extra parameter has no name"

msgid "warning.extra_parameter.empty_name:description"
msgstr "Entry {0} was skipped because its parameter name is empty."

msgid "warning.extra_parameter.empty_name:hint"
msgstr "Enter a parameter name, or remove the entry if you do not need it."

msgid "warning.extra_parameter.missing_menu_item"
msgstr "An extra parameter has no menu item"

msgid "warning.extra_parameter.missing_menu_item:description"
msgstr "Entry {0} was skipped because no menu item is set."

msgid "warning.extra_parameter.missing_menu_item:hint"
msgstr "Set a menu item, or remove the entry if you do not need it."

msgid "warning.extra_parameter.outside_avatar"
msgstr "An extra parameter refers to a menu item outside the avatar"

msgid "warning.extra_parameter.outside_avatar:description"
msgstr "Entry {0} was skipped because {1} is not part of the avatar being built."

msgid "warning.extra_parameter.outside_avatar:hint"
msgstr "Set a menu item inside this avatar."

msgid "warning.extra_parameter.unsupported_control"
msgstr "An extra parameter refers to a menu item that is neither a toggle nor a button"

msgid "warning.extra_parameter.unsupported_control:description"
msgstr "Entry {0} was skipped because {1} has no single value for on and off."

msgid "warning.extra_parameter.unsupported_control:hint"
msgstr "Set a toggle or button menu item, or specify the parameter by name."

msgid "warning.extra_parameter.unnamed_parameter"
msgstr "An extra parameter refers to a menu item without a parameter name"

msgid "warning.extra_parameter.unnamed_parameter:description"
msgstr "Entry {0} was skipped because {1} has no parameter name and no Reactive Component such as Object Toggle, so Modular Avatar will not assign a name. There is no parameter to write to."

msgid "warning.extra_parameter.unnamed_parameter:hint"
msgstr "Enter a parameter name on the menu item."

msgid "warning.extra_parameter.shared_auto_name"
msgstr "Extra parameter menu items share an automatic parameter name"

msgid "warning.extra_parameter.shared_auto_name:description"
msgstr "Entry {0} was skipped because another menu item gets the same automatic name from Modular Avatar as {1} (on the same object, on a sibling object with the same name, and so on). The numbered names Modular Avatar uses to tell them apart cannot be followed."

msgid "warning.extra_parameter.shared_auto_name:hint"
msgstr "Enter a parameter name on the menu item, or rename the objects so that they no longer collide."

msgid "warning.extra_parameter.reserved_name"
msgstr "An extra parameter uses a name reserved by Kx VRC NativeFT Manager"

msgid "warning.extra_parameter.reserved_name:description"
msgstr "Entry {0} was skipped because its parameter name starts with KxNFTM/Stash/. Kx VRC NativeFT Manager uses these names to store previous values."

msgid "warning.extra_parameter.reserved_name:hint"
msgstr "Specify a parameter whose name does not start with KxNFTM/Stash/."

msgid "warning.extra_parameter.duplicate_name"
msgstr "Extra parameters write to the same parameter"

msgid "warning.extra_parameter.duplicate_name:description"
msgstr "Entry {0} was skipped because an earlier entry writes to the same parameter."

msgid "warning.extra_parameter.duplicate_name:hint"
msgstr "Keep only one entry for each parameter."

msgid "warning.extra_parameter.shared_type"
msgstr "The type of an extra parameter cannot be determined"

msgid "warning.extra_parameter.shared_type:description"
msgstr "Entry {0} was skipped because the parameter of {1} is not declared and another menu item sharing it uses an automatic value. The type Modular Avatar chooses cannot be determined."

msgid "warning.extra_parameter.shared_type:hint"
msgstr "Declare the parameter in Expression Parameters or MA Parameters, or turn off the automatic value on the other menu items."

msgid "warning.extra_parameter.automatic_value"
msgstr "The value of an extra parameter's menu item cannot be determined"

msgid "warning.extra_parameter.automatic_value:description"
msgstr "Entry {0} was skipped because {1} uses an automatic value and other menu items share its parameter. The value Modular Avatar assigns during the build cannot be determined."

msgid "warning.extra_parameter.automatic_value:hint"
msgstr "Turn off the automatic value on the menu item and enter a value."

msgid "inspector.section.sensitivity"
msgstr "Sensitivity"

msgid "inspector.sensitivity.eye"
msgstr "Eye Sensitivity"

msgid "inspector.sensitivity.eye.tooltip"
msgstr "Adds a Radial to the Sensitivity menu that changes the strength of the eyes, eyelids, pupils and brows. Uses 8 more synced bits."

msgid "inspector.sensitivity.lip"
msgstr "Lip Sensitivity"

msgid "inspector.sensitivity.lip.tooltip"
msgstr "Adds a Radial to the Sensitivity menu that changes the strength of the mouth, cheeks, tongue and visemes. Uses 8 more synced bits."

msgid "inspector.sensitivity.max_multiplier"
msgstr "Max Multiplier"

msgid "inspector.sensitivity.max_multiplier.tooltip"
msgstr "Strength when the Radial is turned all the way up. The Blendshapes Set multipliers are raised to this value at build time and divided back with the Set weight."

msgid "inspector.sensitivity.saved"
msgstr "Saved"

msgid "inspector.sensitivity.saved.tooltip"
msgstr "Keeps the Radial value across worlds."

msgid "inspector.sensitivity.description"
msgstr "The center of the Radial (the default) is 1x, and the strength changes in 8 steps: 0.2x to 0.8x on the left, and 1x up to the max multiplier on the right. Turning a group off with its toggle stops it regardless of the sensitivity."

