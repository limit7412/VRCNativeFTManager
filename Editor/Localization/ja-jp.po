msgstr "トグル"

msgid "inspector.toggle.show_in_menu"
msgstr "メニュー"

msgid "inspector.toggle.show_in_menu.tooltip"
msgstr "EXメニューに出し、同期パラメーターを作ります。出さないトグルは常に既定値として扱います"

msgid "inspector.toggle.default_value"
msgstr "既定値"

msgid "inspector.toggle.default_value.tooltip"
msgstr "パラメーターの既定値"

msgid "inspector.toggle.saved"
msgstr "保存"

